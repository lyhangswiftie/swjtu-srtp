+        line: i + 1,
+        text: text.startsWith('-') ? text : `- ${text}`,
+        isHighlight: text.includes('漏洞') || text.includes('clientip') || text.includes('strcpy'),
+      }));
+      const afterLines = firstEntry.diffAfter.split('\n').map((text, i) => ({
+        line: i + 1,
+        text: text.startsWith('+') ? text : `+ ${text}`,
+        isHighlight: text.includes('修复') || text.includes('value_esc') || text.includes('strncpy'),
+      }));
+      setDiffData({
+        file: diffFile,
+        originalCode: beforeLines,
+        modifiedCode: afterLines,
+      });
+    }
+
+    // 推送初始化日志
+    setSystemLogs(prev => [...prev,
+      inferLogEntry(`[SCA-010] 单漏洞专注模式已启动，默认加载第一个漏洞: ${firstEntry.id}`, prev.length),
+      inferLogEntry(`[SCA-010] CPG 已加载：${firstEntry.cpg.nodes.length} 个节点, ${firstEntry.cpg.edges.length} 条边`, prev.length + 1),
+      inferLogEntry(`[SCA-010] Diff 已加载：${firstEntry.targetFile || firstEntry.cpg.file}`, prev.length + 2),
+    ]);
+  // eslint-disable-next-line react-hooks/exhaustive-deps
