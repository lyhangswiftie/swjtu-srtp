+++// ============================================================
+++// 将扁平文件路径列表转换为树形结构
+++// ============================================================
+++function buildFileTree(
+++  paths: string[],
+++  basePath: string = "/workspace",
+++): FileTreeNodeProps[] {
+++  const root: Record<string, FileTreeNodeProps> = {};
+++
+++  for (const fullPath of paths) {
+++    // 去掉 basePath 前缀
+++    const relativePath = fullPath.startsWith(basePath)
+++      ? fullPath.slice(basePath.length).replace(/^\//, "")
+++      : fullPath.replace(/^\//, "");
+++
+++    const parts = relativePath.split("/").filter(Boolean);
+++    let current = root;
+++    let currentPath = basePath;
+++
+++    for (let i = 0; i < parts.length; i++) {
+++      const part = parts[i];
+++      currentPath = `${currentPath}/${part}`;
+++      const isLast = i === parts.length - 1;
+++
+++      if (!current[part]) {
+++        current[part] = {
+++          name: part,
+++          path: currentPath,
+++          isDir: !isLast,
+++          children: isLast ? undefined : [],
+++          level: i,
+++        };
+++      }
+++
+++      if (!isLast) {
+++        current = current[part].children as unknown as Record<
+++          string,
+++          FileTreeNodeProps
+++        >;
+++        if (!current) {
+++          current = {};
+++        }
+++      }
+++    }
+++  }
+++
+++  const toArray = (
+++    obj: Record<string, FileTreeNodeProps>,
+++  ): FileTreeNodeProps[] =>
+++    Object.values(obj).sort((a, b) => {
+++      // 目录排在文件前面
+++      if (a.isDir && !b.isDir) return -1;
+++      if (!a.isDir && b.isDir) return 1;
+++      return a.name.localeCompare(b.name);
+++    });
+++
+++  return toArray(root);
+++}
