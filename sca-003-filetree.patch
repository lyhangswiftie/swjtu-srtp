+ */
+function contentToDiffData(content: string, file: string): DiffData {
+  const lines = content.split('\n');
+  const diffLines: DiffLine[] = lines.map((text, i) => ({
+    line: i + 1,
+    text,
+    isHighlight: false,
+  }));
+  return {
+    file,
+    originalCode: diffLines,
+    modifiedCode: diffLines,
+  };
+}
