+/**
+ * DashboardConnected.tsx
+ *
+ * SeCodeAct HUD 主控制台 —— 真实数据集成版本
+ *
+ * 本文件在 Dashboard.tsx（UI 原型）的基础上，将三处 Mock 数据源替换为
+ * OpenHands 前端的真实 Zustand Store 和 WebSocket Hook：
+ *
+ *  1. chatMessages / handleSendMessage
+ *     Mock  → useState 本地数组 + setTimeout 模拟回复
+ *     真实  → useEventStore (事件流) + useSendMessage (WebSocket 发送)
+ *
+ *  2. terminalLogs
+ *     Mock  → useState 本地字符串数组
+ *     真实  → useCommandStore (沙箱 stdout/stderr 实时流)
+ *
+ *  3. diffData (Diff Viewer)
+ *     Mock  → 硬编码的 originalCode / modifiedCode 数组
+ *     真实  → useGitChanges + useGitChangeDiff (v1-git-service API)
+ *             当无真实 Diff 数据时，自动回退到 Mock 数据展示
+ *
+ * 路由集成：conversation.tsx 中将 <ScaDashboard /> 替换为 <DashboardConnected />
+ */
+
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  ShieldAlert, Cpu, Database, Activity, TerminalSquare, Server,
+  CheckCircle2, FileCode2, FolderOpen, File, ChevronRight, ChevronDown,
+  AlertCircle, MessageSquare, Code, Settings, X, Box, LayoutDashboard,
+  History, FolderKanban, Plus, Search, Clock, FolderTree, Github,
+  GitBranch, FileText, PlayCircle
+} from 'lucide-react';
+import { OpenHandsChat, OpenHandsTerminal, OpenHandsDiffViewer } from './OpenHandsMocks';
+
+// ── 真实数据 Hook ──────────────────────────────────────────────────────────────
+import { useEventStore } from '#/stores/use-event-store';
+import { useCommandStore } from '#/stores/command-store';
+import { useSendMessage } from '#/hooks/use-send-message';
+import { useConversationId } from '#/hooks/use-conversation-id';
+import GitService from '#/api/git-service/git-service.api';
+import type { GitChangeDiff } from '#/api/open-hands.types';
+
+// ── 类型定义 ───────────────────────────────────────────────────────────────────
+
+/** 漏洞条目，用于漏洞列表面板 */
+interface VulnItem {
+  id: string;
+  file: string;
+  severity: string;
+  severityClass: string;
+  status: string;
+  statusClass: string;
+  active: boolean;
+}
+
+/** Diff Viewer 单行数据 */
+interface DiffLine {
+  line: number;
+  text: string;
+  isHighlight: boolean;
+}
+
+/** Diff Viewer 数据集 */
+interface DiffData {
+  file: string;
+  originalCode: DiffLine[];
+  modifiedCode: DiffLine[];
+}
+
+// ── 工具函数 ───────────────────────────────────────────────────────────────────
+
+/**
+ * 将 OpenHands 事件流（OHEvent）转换为 Chat 消息格式。
+ *
+ * OpenHands V1 事件结构：
+ *   - source === 'user'  → role: 'user'
+ *   - source === 'agent' → role: 'agent'
+ *   - message / content 字段存储文本内容
+ */
+function eventsToMessages(events: ReturnType<typeof useEventStore.getState>['uiEvents']) {
+  const messages: { role: 'user' | 'agent'; text: string }[] = [];
+  for (const ev of events) {
+    // 兼容 V0（OpenHandsParsedEvent）和 V1（OpenHandsEvent）
+    const source = (ev as any).source ?? (ev as any).role;
+    const text =
+      (ev as any).message ??
+      (ev as any).content ??
+      (ev as any).args?.content ??
+      '';
+    if (!text) continue;
+    if (source === 'user') {
