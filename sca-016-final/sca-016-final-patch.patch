diff --git a/src/libs/zbxaudit/audit.c b/src/libs/zbxaudit/audit.c
index a3f8b2c..d7e9f1a 100644
--- a/src/libs/zbxaudit/audit.c
+++ b/src/libs/zbxaudit/audit.c
@@ -178,12 +178,15 @@ static void	zbx_audit_entry_append_ip(zbx_audit_entry_t *entry, const char *cli
 	char	*value_esc;
 
 	/* CVE-2024-22120 漏洞修复：使用转义后的字符串替代直接拼接 */
