+    # 解决方案：
+    #   - --cap-add NET_ADMIN: 允许容器修改网络配置（iptables/路由表）
+    #   - --cap-add NET_RAW:   允许容器使用 RAW socket（iptables raw 表）
+    #   - AGENT_SERVER_USE_HOST_NETWORK=true: 沙箱子容器使用宿主机网络
+    #   - SANDBOX_USE_HOST_NETWORK=true: 主容器网络配置兼容旧版
+    echo "[*] WSL2 模式：添加 NET_ADMIN/NET_RAW 权限"
+    sudo docker run -d \
+        --name openhands-sca \
+        --network host \
+        --cap-add NET_ADMIN \
+        --cap-add NET_RAW \
+        -e SANDBOX_USE_HOST_NETWORK=true \
+        -e AGENT_SERVER_USE_HOST_NETWORK=true \
+        -e OPENAI_API_KEY="${OPENAI_API_KEY}" \
+        -e LLM_MODEL="${LLM_MODEL_NAME}" \
+        -e LLM_API_KEY="${OPENAI_API_KEY}" \
+        -v /var/run/docker.sock:/var/run/docker.sock \
+        -v ~/.openhands:/.openhands \
+        ghcr.io/openhands/openhands:1.6.0
+else
+    # ── 标准 Linux 启动参数 ───────────────────────────────────
+    echo "[*] 标准 Linux 模式：Host Network + 双网络变量"
+    sudo docker run -d \
+        --name openhands-sca \
+        --network host \
+        -e SANDBOX_USE_HOST_NETWORK=true \
+        -e AGENT_SERVER_USE_HOST_NETWORK=true \
+        -e OPENAI_API_KEY="${OPENAI_API_KEY}" \
+        -e LLM_MODEL="${LLM_MODEL_NAME}" \
+        -e LLM_API_KEY="${OPENAI_API_KEY}" \
+        -v /var/run/docker.sock:/var/run/docker.sock \
+        -v ~/.openhands:/.openhands \
+        ghcr.io/openhands/openhands:1.6.0
+fi
+
+# ─── 7. 等待容器就绪（健康检查替代固定 sleep）───────────────
+echo "[*] 等待 OpenHands 容器就绪（最多 60 秒）..."
+READY=false
+for i in $(seq 1 60); do
+    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
+        http://localhost:3000/api/options/config 2>/dev/null || echo "000")
+    if [ "$HTTP_CODE" = "200" ]; then
+        echo "[✓] 容器已就绪（${i}秒，HTTP 200）"
+        READY=true
+        break
+    fi
+    printf "."
+    sleep 1
+done
+echo ""
 
-# 7. 注入 SCA-HUD 前端
-echo "[*] 等待容器启动 (15秒)..."
-sleep 15
+if [ "$READY" = false ]; then
+    echo "[!] 容器启动超时，尝试继续注入前端..."
+fi
 
+# ─── 8. 注入 SCA-HUD 前端 ────────────────────────────────────
 echo "[*] 正在注入 SCA-HUD 前端至容器..."
-sudo docker cp frontend/build/. openhands-sca:/app/frontend/build/
+sudo docker cp "$SCRIPT_DIR/frontend/build/." openhands-sca:/app/frontend/build/
+echo "[✓] SCA-HUD 前端注入完成"
 
+# ─── 9. 最终健康检查 ─────────────────────────────────────────
+sleep 2
+HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
+    http://localhost:3000/api/options/config 2>/dev/null || echo "000")
+
+echo ""
 echo "============================================================"
-echo "✅ 安装与部署完成！"
+if [ "$HTTP_CODE" = "200" ]; then
+    echo "✅ 安装与部署完成！API 健康检查通过（HTTP 200）"
+else
+    echo "⚠️  安装完成，但 API 尚未响应（HTTP ${HTTP_CODE}）"
+    echo "   请稍等片刻后访问，或执行以下命令查看日志："
+    echo "   sudo docker logs openhands-sca --tail 50"
+fi
+echo ""
 echo "🌐 SCA-HUD 访问地址: http://localhost:3000"
+echo ""
+echo "📋 WSL2 用户注意事项："
+echo "   1. 确认 Docker Desktop 已启用 'Use WSL 2 based engine'"
+echo "   2. 若仍报 500 错误，执行: sudo docker logs openhands-sca --tail 50"
+echo "   3. 确认 Windows 防火墙未拦截 3000 端口"
+echo "   4. 若使用 Docker Desktop，请在 Settings > Resources > WSL Integration 中"
+echo "      启用对应的 WSL2 发行版"
+echo "   5. 如需使用其他 LLM 模型，执行前设置:"
+echo "      export LLM_MODEL='gpt-4.1-mini'  # 或 gemini-2.5-flash 等"
