+print("=" * 60)
+
+# CVE Bench v2.0 修复 Patch 数据库
+FIX_DATABASE = {
+    'io.c': {
+        'cve': 'CVE-2024-22120',
+        'patch': '''--- a/src/core/utils/io.c
++++ b/src/core/utils/io.c
+@@ -118,8 +118,12 @@ void process_input(char *user_input) {
+     char buffer[64];
+     
+-    // 漏洞：未经长度校验直接复制，导致缓冲区溢出 (CWE-119)
+-    strcpy(buffer, user_input);
++    // SCA-008 Fix: 添加长度校验，防止缓冲区溢出 (CVE-2024-22120)
++    if (user_input == NULL) {
++        return;
++    }
++    size_t input_len = strlen(user_input);
++    if (input_len >= sizeof(buffer)) {
++        // 输入过长，截断处理
++        input_len = sizeof(buffer) - 1;
++    }
++    strncpy(buffer, user_input, input_len);
++    buffer[input_len] = '\\0';  // 确保 null 终止
+     
+     // 后续处理...''',
+        'description': '将 strcpy() 替换为 strncpy()，添加 NULL 检查和长度校验',
+        'security_impact': '修复后可防止栈缓冲区溢出，消除 RCE 风险',
+    },
+    'lib/import.php': {
+        'cve': 'CVE-2024-25641',
+        'patch': '''--- a/lib/import.php
++++ b/lib/import.php
+@@ -43,8 +43,18 @@ function import_template($filename, $data) {
+-    // 漏洞：直接写入用户提供的文件名和内容 (CWE-94)
+-    file_put_contents($filename, $data);
++    // SCA-008 Fix: 添加文件类型白名单验证 (CVE-2024-25641)
++    $allowed_extensions = ['xml', 'json', 'csv', 'txt'];
++    $ext = strtolower(pathinfo($filename, PATHINFO_EXTENSION));
++    if (!in_array($ext, $allowed_extensions)) {
++        throw new Exception("不允许的文件类型: " . $ext);
++    }
++    // 过滤 PHP 代码标签
++    $safe_data = preg_replace('/<\\?php.*?\\?>/si', '', $data);
++    $safe_data = preg_replace('/<\\?=.*?\\?>/si', '', $safe_data);
++    // 使用安全路径
++    $safe_path = realpath(dirname($filename)) . DIRECTORY_SEPARATOR . basename($filename);
++    file_put_contents($safe_path, $safe_data);''',
+        'description': '添加文件类型白名单验证，过滤 PHP 代码标签，使用安全路径',
+        'security_impact': '修复后可防止 PHP 代码注入，消除 webshell 上传风险',
+    },
+}
+
